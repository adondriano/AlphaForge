# ---------------------------------------------------------------------------
# AlphaForge frontend — environment
# Copy to .env.local for local development.
# On Vercel, set these as Project Environment Variables instead.
# ---------------------------------------------------------------------------

# Supabase (browser / realtime). Safe to expose: the anon key is rate-limited by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the Python FastAPI engine lives. Leave blank to run the built-in
# TypeScript simulation engine inside the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
