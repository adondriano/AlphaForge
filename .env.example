# =============================================================================
# AlphaForge — environment template
# Copy to `.env.local` (frontend) / `.env` (backend). Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — database, auth and Realtime
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Safe to expose: rate limited by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server side ONLY. Never expose to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Python engine
# -----------------------------------------------------------------------------
# Where the FastAPI engine lives. Leave blank to run the in-browser TypeScript
# engine instead (the studio is fully functional either way).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to 0 to disable the demo strategies seeded on first boot.
ALPHAFORGE_SEED=1

# -----------------------------------------------------------------------------
# Execution — MetaTrader 5 (Windows only)
# -----------------------------------------------------------------------------
MT5_PATH=
MT5_LOGIN=
MT5_SERVER=

# -----------------------------------------------------------------------------
# LLM orchestration (optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# -----------------------------------------------------------------------------
# Prop-Firm risk envelope (hard middleware)
# -----------------------------------------------------------------------------
MAX_DAILY_DRAWDOWN=3.5
MAX_TOTAL_DRAWDOWN=5.0
RISK_PER_TRADE_PCT=0.5
MAX_CONCURRENT_TRADES=2
BEST_DAY_PROFIT_CAP_PCT=35.0
EMERGENCY_LIQUIDATE_ON_BREACH=true
